#!/usr/bin/env bash
# Launch ONLY the Firefox MCP debug profile with remote debugging enabled.
# Never points at the MWS profile.
# Always starts a fresh window (no restored tabs).
#
# Canonical copy lives in this repo (scripts/firefox-mcp). Symlink to ~/bin:
#   ln -sfn /home/mws/git/better-bunpro/scripts/firefox-mcp ~/bin/firefox-mcp
set -euo pipefail

MCP_PROFILE="/home/mws/.config/mozilla/firefox/0FdAaoTJ.Profile 1"
MWS_PROFILE="/home/mws/.config/mozilla/firefox/6awon870.default-release"
INSTALL_URL="http://127.0.0.1:5173/__vite-plugin-monkey.install.user.js"

if [[ "${1:-}" == "--help" ]]; then
  cat <<'EOF'
Usage: firefox-mcp [url]

Starts the MCP Firefox profile with Marionette + remote debugging so
@mozilla/firefox-devtools-mcp can attach (--connect-existing).

Always a fresh session: stops any existing MCP Firefox for this profile,
clears session restore files, and opens the URL (default Bunpro reviews)
plus the Vite Tampermonkey install URL as a second tab (no window.open /
about:blank leftover).

Refuses to run against the MWS profile.
EOF
  exit 0
fi

if [[ ! -d "$MCP_PROFILE" ]]; then
  echo "MCP profile missing: $MCP_PROFILE" >&2
  exit 1
fi

# Hard guard — never touch MWS even if args are wrong.
for arg in "$@"; do
  if [[ "$arg" == *"$MWS_PROFILE"* ]] || [[ "$arg" == *MWS* && "$arg" == *profile* ]]; then
    echo "Refusing: MWS profile is off-limits." >&2
    exit 1
  fi
done

URL="${1:-https://bunpro.jp/reviews}"

# Stop any existing MCP Firefox so we do not attach to a dirty window.
if pgrep -f "firefox --profile ${MCP_PROFILE}" >/dev/null 2>&1; then
  pkill -f "firefox --profile ${MCP_PROFILE}" || true
  for _ in $(seq 1 50); do
    pgrep -f "firefox --profile ${MCP_PROFILE}" >/dev/null 2>&1 || break
    sleep 0.1
  done
  pkill -9 -f "firefox --profile ${MCP_PROFILE}" 2>/dev/null || true
fi

# Drop restore payloads so startup cannot bring old tabs back.
rm -f \
  "$MCP_PROFILE/sessionstore.jsonlz4" \
  "$MCP_PROFILE/sessionstore-backups/recovery.jsonlz4" \
  "$MCP_PROFILE/sessionstore-backups/recovery.baklz4" \
  "$MCP_PROFILE/sessionstore-backups/previous.jsonlz4"

# Persist: blank startup, never resume previous session (MCP profile only).
cat >"$MCP_PROFILE/user.js" <<'EOF'
// Managed by better-bunpro/scripts/firefox-mcp — MCP debug profile only.
user_pref("browser.startup.page", 0);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.sessionstore.restore_on_demand", false);
EOF

# Two URLs as startup tabs — avoids window.open() leaving about:blank.
exec /usr/bin/firefox \
  --profile "$MCP_PROFILE" \
  --marionette \
  --remote-debugging-port=9222 \
  "$URL" \
  "$INSTALL_URL"
